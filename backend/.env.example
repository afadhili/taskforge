# ─────────────────────────────────────────────────────────────
# TaskForge — environment configuration (example)
#
# Copy to `.env` before first run:
#     cp backend/.env.example backend/.env
#
# IMPORTANT — keep defaults in `.env.example` identical.  The
# application always reads `backend/.env`; `.env.example` is the
# template that ships to fresh machines.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=TaskForge
# APP_ENV:  local | staging | production  (local = development)
APP_ENV=local
# APP_KEY:  leave blank in .env.example; run `php artisan key:generate`
#          on every clone.  Laravel will emit "No application encryption
#          key" until this is set.
APP_KEY=
# APP_DEBUG:  true = show stack traces (local only).  false in production.
APP_DEBUG=true
# APP_URL:  absolute URL of the API + frontend (no trailing slash).
#          The React SPA proxies /api/v1* to this host.
APP_URL=http://localhost:8000

# ── Internationalisation ─────────────────────────────────────
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ── Maintenance ──────────────────────────────────────────────
# APP_MAINTENANCE_DRIVER=file  (default) keeps the maintenance file in
# storage/framework/maintenance.php.  Set to `database` to use the
# `app.maintenance` table instead.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database   # (only when APP_MAINTENANCE_DRIVER=database)

# PHP_CLI_SERVER_WORKERS=4        # (optional) PHP built-in server worker count

# ── Hashing ──────────────────────────────────────────────────
# BCRYPT_ROUNDS=12   (Laravel default; raise for production)

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# LOG_LEVEL:  debug | info | notice | warning | error | critical | alert | emergency

# ── Database ─────────────────────────────────────────────────
# DB_CONNECTION=pgsql   (alternatives: sqlite, mysql, mariadb)
DB_CONNECTION=pgsql
# DB_HOST/DB_PORT depend on where PHP runs:
#   Docker Compose: postgres:5432 (the compose file overrides these values).
#   Host PHP:       127.0.0.1:5433 (the host-mapped PostgreSQL port).
DB_HOST=postgres
DB_PORT=5432
# DB_DATABASE:  Database name the app connects to.
DB_DATABASE=taskforge
# DB_USERNAME:  Role with CREATE/CONNECT privilege on the database.
DB_USERNAME=taskforge
# DB_PASSWORD:  Password for DB_USERNAME.
DB_PASSWORD=taskforge-local

# ── Sessions ─────────────────────────────────────────────────
# SESSION_DRIVER=database  (default) keeps sessions in the `sessions` table.
SESSION_DRIVER=database
SESSION_LIFETIME=120   # minutes
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null    # set to e.g. ".taskforge.local" for subdomain sharing

# ── Broadcast ────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# ── Files / Storage ──────────────────────────────────────────
FILESYSTEM_DISK=local
# FILESYSTEM_DISK=public  (if you need public/uploads access via /storage)

# ── Queue ────────────────────────────────────────────────────
# QUEUE_CONNECTION=database  (default) uses the `jobs` table.
QUEUE_CONNECTION=database

# ── Cache ────────────────────────────────────────────────────
CACHE_STORE=database
# CACHE_PREFIX=  (optional prefix for cache keys)

# ── Memcached (optional) ─────────────────────────────────────
# MEMCACHED_HOST=127.0.0.1

# ── Redis ────────────────────────────────────────────────────
# REDIS_CLIENT=phpredis  (default)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ─────────────────────────────────────────────────────
# MAIL_MAILER=log  (default; use "smtp" / "sendmail" / "mailgun" etc. in prod)
MAIL_MAILER=log
MAIL_SCHEME=null   # http | https
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 (optional) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── OAuth providers ──────────────────────────────────────────
# Fill these values from Google Cloud Console and GitHub OAuth Apps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Register these exact frontend callback URLs with each provider, and keep
# them identical in the provider dashboard and these redirect URI settings.
GOOGLE_REDIRECT_URI=http://localhost:5174/oauth/google/callback
GITHUB_REDIRECT_URI=http://localhost:5174/oauth/github/callback

# ── AI Assistant (OpenAI-compatible) ─────────────────────────
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# ── Webhook signing (optional) ───────────────────────────────
# WEBHOOK_SECRET=  (if implemented in the future)
